<!DOCTYPE html>
<html lang="es">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Registro</title>
    <link rel="stylesheet" href="../../src/styles/styleReg.css">
</head>

<body class="login">
    <header>
        <div class="contenedor-header">
            <nav class="botones">
                <a href="/">INICIO</a>
                <a href="/especialidades">ESPECIALIDADES</a>
                <a href="/#contacto">CONTACTO</a>
            </nav>

            <div class="logueo">
                <a href="/register" id="reg">REGISTRARSE</a>
                <a href="/login" id="log">LOGIN</a>
            </div>
            
        </div>
    </header>
    <main class="main-login">
        <form class="form-login">
            <h2>Registrate</h2>
            <label for="nombres">Nombre/s:</label>
            <input type="text" id="nombres" placeholder="Ingrese sus nombres" name="nombres" required>

            <label for="apellidos">Apellido/s:</label>
            <input type="text" id="apellidos" placeholder="Ingrese sus apellidos" name="apellidos" required>

            <label for="dni">DNI:</label>
            <input type="number" id="dni" placeholder="12345678" name="dni" max="99999999" required>

            <label for="mail">Email:</label>
            <input type="email" id="mail" placeholder="example@gmail.com" name="mail" required>

            <label for="telefono">Telefono:</label>
            <input type="phone" id="telefono" placeholder="11 2233-4455" name="telefono" required>

            <label for="passw">Contraseña:</label>
            <input type="password" id="password" placeholder="Ingrese su contraseña" name="password" required>

            <button type="submit">Registrarse</button>
        </form>
    </main>
    <footer>
        <p>&copy; 2025 Escuela Secundaria San Martín. Todos los derechos reservados.</p>
    </footer>

    <script>

        document.querySelector('form').addEventListener('submit', async (event) => {
            event.preventDefault()
            
            const formData = new FormData(event.target)
            
            const nombres = formData.get('nombres')
            const apellidos = formData.get('apellidos')
            const dni = formData.get('dni')
            const mail = formData.get('mail')
            const telefono = formData.get('telefono')
            const password = formData.get('password')

            const resultFetch = await fetch('http://localhost:3000/register-user', {
                    method: 'POST',
                    credentials: "include",
                    headers: {
                        'Content-Type': 'application/json'
                    },
                    body: JSON.stringify({
                        nombres: nombres,
                        apellidos: apellidos,
                        dni: dni,
                        telefono: telefono,
                        mail: mail,
                        password: password
                    })
                })
            

            console.log(resultFetch)

            

        })

    </script>

</body>
</html>