<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
    <link rel="stylesheet" href="../src/styles/stylePanProf.css">
</head>

<body>
    <header>
        <div class="contenedor-header">
            <nav class="botones">
                <a href="/">INICIO</a>
                <a href="/especialidades">ESPECIALIDADES</a>
                <a href="/#contacto">CONTACTO</a>
                <a href="/panel">PANEL</a>
            </nav>
            <div class="tag-user">
                <a>
                    <%= nombres %>
                </a>
            </div>
    </header>
    <section class="panel">
        <div class="opciones">
            <button id="cuenta" type="button">MI CUENTA</button>
            <button id="notas" type="button">NOTAS</button>
            <button id="materiaaa" type="button">MATERIAS</button>
            <button id="cerrar-ses" type="button">Cerrar Sesion</button>
        </div>
        <div id="inicio" class="datos">
            <div class="container">
                <h2>Mi Cuenta</h2>
                <div class="fila-datos">
                    <p>Nombre:</p>
                    <span id="nombre">
                        <%= nombres %>
                    </span>
                </div>
                <div class="fila-datos">
                    <p>Apellido:</p>
                    <span id="apellido">
                        <%= apellidos %>
                    </span>
                </div>
                <div class="fila-datos">
                    <p>DNI:</p>
                    <span id="dni">
                        <%= dni %>
                    </span>
                </div>
                <div class="fila-datos-mail">
                    <p>Email:</p>
                    <span id="mail">
                        <%= email %>
                    </span>
                    <button type="button" class="boton-mail" id="emailCambiar"><i
                            class="fas fa-pen-to-square"></i></button>
                </div>
                <div class="fila-datos">
                    <p>Telefono:</p>
                    <span id="telefono">
                        <%= telefono %>
                    </span>
                </div>
                <div class="fila-datos-contraseña">
                    <p>Contraseña:</p>
                    <span id="contraseña">********</span>
                    <button type="button" class="boton-contraseña" id="passwordCambiar"><i
                            class="fas fa-pen-to-square"></i></button>
                </div>
            </div>
        </div>
        <div id="notitas" class="notas">
            <div class="container">
                <h2>Notas</h2>
                <div class="student-info">
                    <h3 id="student-name">Docente: <%= nombres %>
                    </h3>
                </div>

                <div class="summary">
                    <div class="card">
                        <h2 id="total-aprobados">Nueva nota</h2>
                        <form class="ingreso-nota">
                            <div class="inputs">
                                <label for="nuevaNota">Nota:</label>
                                <select class="n-nota" name="n-nota" id="nuevaNota">
                                    <option value=1>1</option>
                                    <option value=2>2</option>
                                    <option value=3>3</option>
                                    <option value=4>4</option>
                                    <option value=5>5</option>
                                    <option value=6>6</option>
                                    <option value=7>7</option>
                                    <option value=8>8</option>
                                    <option value=9>9</option>
                                    <option value=10>10</option>
                                </select>
                            </div>
                            <div class="inputs">
                                <label for="materiaNota">Materia:</label>
                                <select class="n-materia" name="n-materia" id="materiaNota">
                                    <% if ( cantMate != 0 ) { %>
                                        <% for( let i = 0; i < materiaId.length; i++){ %>
                                            <option value="<%= materiaId[i] %>"><%= materiasMate[i]%> | <%= anioMate[i]%>° <%= cursoMate[i]%>°</option>
                                        <% } %>
                                    <% } %>
                                </select>
                            </div>
                            <div class="inputs">
                                <label for="nombreAlumno">Alumno:</label>
                                <select class="n-nombre" name="n-nombre" id="nombreAlumno">
                                    <option value="">Seleccione una materia</option>
                                </select>
                            </div>
                            <div class="inputs">
                                <button type="submit" class="btn-enviar">ENVIAR</button>
                            </div>
                        </form>
                    </div>
                </div>
                <form class="filter-form" id="filter-form">
                    <div>
                        <label for="n-nota-select">Nota:</label>
                        <select id="n-nota-select" class="n-nota">
                            <option value=1>1</option>
                            <option value=2>2</option>
                            <option value=3>3</option>
                            <option value=4>4</option>
                            <option value=5>5</option>
                            <option value=6>6</option>
                            <option value=7>7</option>
                            <option value=8>8</option>
                            <option value=9>9</option>
                            <option value=10>10</option>
                        </select>
                    </div>
                    <div>
                        <label for="materia">Materia:</label>
                        <select id="materia" name="materia">
                            <option value="todas">Todas</option>
                            <% if ( cantMate != 0 ) { %>
                                <% for( let i = 0; i < materiasMate.length; i++){ %>
                                    <option value="<%= materiasMate[i] %>"><%= materiasMate[i] %></option>
                                <% } %>
                            <% } %>
                        </select>
                        <button type="submit">Filtrar</button>
                    </div>
                </form>
                <div class="scroll-table">
                    <table>
                        <thead>
                            <tr>
                                <th>Materia</th>
                                <th>Año</th>
                                <th>Curso</th>
                                <th>Nota</th>
                                <th>Alumno</th>
                            </tr>
                        </thead>
                        <tbody id="tabla-notas" class="tabla-notas">
                            <% if(nota){ %>
                                <% for(let i = 0; i < nota.length; i++){ %>
                                    <tr>
                                        <td><%= nombreMat[i] %></td>
                                        <td><%= anio[i] %></td>
                                        <td><%= curso[i] %></td>
                                        <td><%= nota[i] %></td>
                                        <td><%= nombreAlum[i] %></td>
                                    </tr>

                                <% } %>
                            <% }else{%>
                            
                                <tr>
                                    <td colspan="5">No hay notas asignadas</td>
                                </tr>

                            <%} %>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
        <div id="materias" class="notas">
            <div class="container">
                <h2>Materias</h2>
                <div class="student-info">
                    <h3 id="student-name">Docente: <%= nombres %>
                    </h3>
                </div>

                <div class="summary">
                    <div class="card">
                        <% if( cantMate != 0) {%>
                        
                        <h2 id="total-aprobados"><%= cantMate %></h2>

                        <% } else { %> <h2 id="total-aprobados">3</h2> <% } %>
                        
                        <p>Cantidad de Materias</p>
                    </div>
                </div>
                <div class="scroll-table" style="margin-top: 4vh">
                    <table>
                        <thead>
                            <tr>
                                <th>Materia</th>
                                <th>Año</th>
                                <th>Curso</th>
                                <th>Turno</th>
                            </tr>
                        </thead>
                        <tbody id="tabla-notas" class="tabla-notas">
                            <% if ( cantMate != 0) { %>
                                <% for( let i = 0 ; i < materiasMate.length; i++) { %>
                                
                                    <tr>
                                        <td><%= materiasMate[i] %></td>
                                        <td><%= anioMate[i] %>°</td>
                                        <td><%= cursoMate[i] %>°</td>
                                        <td><%= turnoMate[i] %></td>
                                    </tr>
                                    
                                <% } %>

                            <% } %>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </section>
    <footer>
        <p>&copy; 2025 Escuela Secundaria San Martín. Todos los derechos reservados.</p>
    </footer>
    <div id="cambioPassword" class="cambio-password" style="display: none;">
        <div class="cambio-password-contenido">
            <button id="boton-cerrar-password" type="button">X</button>
            <h2>Cambiar Contraseña</h2>
            <input type="password" placeholder="Contraseña Actual" class="contra" required>
            <input type="password" placeholder="Nueva Contraseña" class="contra" required>
            <input type="password" placeholder="Confirmar Contraseña" class="contra" required>
            <button id="boton-actualizar-password" type="button">Actualizar</button>
        </div>
    </div>
    <div id="cambioMail" class="cambio-mail" style="display: none;">
        <div class="cambio-mail-contenido">
            <button id="boton-cerrar-mail" type="button">X</button>
            <h2>Cambiar Email</h2>
            <input type="email" placeholder="Nuevo email" class="email" required>
            <button id="boton-actualizar-mail" type="button">Actualizar</button>
        </div>
    </div>
    <script preload>

        document.getElementById("cerrar-ses").addEventListener("click", () => {
            fetch('/logout', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json'
                }
            }).then(response => {
                if (typeof response.ok === 'boolean') {
                    window.location.href = '/'
                }
            })
        });

        //Botones del Panel B)
        actualizarBotonesActivos("cuenta");

        document.getElementById("cuenta").addEventListener("click", () => {
            document.getElementById("inicio").style.display = "flex";
            document.getElementById("notitas").style.display = "none";
            document.getElementById("materias").style.display = "none";
            actualizarBotonesActivos("cuenta");
        });

        document.getElementById("notas").addEventListener("click", () => {
            document.getElementById("inicio").style.display = "none";
            document.getElementById("notitas").style.display = "flex";
            document.getElementById("materias").style.display = "none";
            actualizarBotonesActivos("notas");
        });
        document.getElementById("materiaaa").addEventListener("click", () => {
            document.getElementById("inicio").style.display = "none";
            document.getElementById("notitas").style.display = "none";
            document.getElementById("materias").style.display = "flex";
            actualizarBotonesActivos("materiaaa");
        });

        function actualizarBotonesActivos(idActivo) {
            document.querySelectorAll("#cuenta, #materiaaa, #notas").forEach(boton => {
                if (boton.id === idActivo) {
                    boton.classList.add("activo");
                } else {
                    boton.classList.remove("activo");
                }
            });
        }

        //Cambio contraseña :O
        document.getElementById("passwordCambiar").addEventListener("click", function () {
            document.getElementById('cambioPassword').style.display = 'flex'
        })
        document.getElementById("boton-actualizar-password").addEventListener("click", function () {
            document.getElementById('cambioPassword').style.display = 'none'
        })
        document.getElementById("boton-cerrar-password").addEventListener("click", function () {
            document.getElementById('cambioPassword').style.display = 'none'
        })


        //Cambio email :O
        document.getElementById("emailCambiar").addEventListener("click", function () {
            document.getElementById('cambioMail').style.display = 'flex'
        })
        document.getElementById("boton-actualizar-mail").addEventListener("click", function () {
            document.getElementById('cambioMail').style.display = 'none'
        })
        document.getElementById("boton-cerrar-mail").addEventListener("click", function () {
            document.getElementById('cambioMail').style.display = 'none'
        })

    </script>
</body>

</html>