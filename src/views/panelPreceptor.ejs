<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Escuela San Martín</title>
    <link rel="stylesheet" href="../src/styles/stylePanPrece.css">
</head>

<body>
    <header>
        <div class="contenedor-header">
            <nav class="botones">
                <a href="/">INICIO</a>
                <a href="/especialidades">ESPECIALIDADES</a>
                <a href="/#contacto">CONTACTO</a>
                <a href="/panel">PANEL</a>
            </nav>
            <div class="tag-user">
                <a>
                    <%= nombres %>
                </a>
            </div>
    </header>
    <section class="panel">
        <div class="opciones">
            <button id="cuenta" type="button">MI CUENTA</button>
            <button id="apartadoAsistencias" type="button">ASISTENCIAS</button>
            <button id="cerrar-ses" type="button">Cerrar Sesion</button>
        </div>
        <div id="inicio" class="datos">
            <div class="container">
                <h2>Mi Cuenta</h2>
                <div class="fila-datos">
                    <p>Nombre:</p>
                    <span id="nombre">
                        <%= nombres %>
                    </span>
                </div>
                <div class="fila-datos">
                    <p>Apellido:</p>
                    <span id="apellido">
                        <%= apellidos %>
                    </span>
                </div>
                <div class="fila-datos">
                    <p>DNI:</p>
                    <span id="dni">
                        <%= dni %>
                    </span>
                </div>
                <div class="fila-datos-mail">
                    <p>Email:</p>
                    <span id="mail">
                        <%= email %>
                    </span>
                    <button type="button" class="boton-mail" id="emailCambiar"><i
                            class="fas fa-pen-to-square"></i></button>
                </div>
                <div class="fila-datos">
                    <p>Telefono:</p>
                    <span id="telefono">
                        <%= telefono %>
                    </span>
                </div>
                <div class="fila-datos-contraseña">
                    <p>Contraseña:</p>
                    <span id="contraseña">********</span>
                    <button type="button" class="boton-contraseña" id="passwordCambiar"><i
                            class="fas fa-pen-to-square"></i></button>
                </div>
            </div>
        </div>
        <div id="asistencias" class="asist">
            <div class="container">
                <h2>Asistencias</h2>
                <form class="filter-form" id="filter-form">
                    <div class="filter-grid">
                        <div class="filter-group">
                            <label for="anios">Año</label>
                            <select name="anios" id="anios">
                                <option value="">-</option>
                                <option value="1">1º</option>
                                <option value="2">2º</option>
                                <option value="3">3º</option>
                                <option value="4">4º</option>
                                <option value="5">5º</option>
                                <option value="6">6º</option>
                            </select>
                        </div>

                        <div class="filter-group">
                            <label for="cursos">Curso</label>
                            <select name="cursos" id="cursos">
                                <option value="">-</option>
                            </select>
                        </div>

                        <div class="filter-group">
                            <label for="alumnos">Alumno</label>
                            <select name="alumnos" id="alumnos">
                                <option value="0">-</option>
                            </select>
                        </div>

                        <div class="filter-group">
                            <label for="orden-asis">Ordenar por</label>
                            <select name="tipo" id="orden-asis">
                                <option value="DESC">Descendente</option>
                                <option value="ASC">Ascendente</option>
                            </select>
                        </div>

                        <div class="filter-group">
                            <label for="tipo-asis">Tipo</label>
                            <select id="tipo-asis" name="tipo">
                                <option value="0">Todas</option>
                                <option value="1">Solo Asistencias</option>
                                <option value="2">Solo Tarde</option>
                                <option value="3">Solo Inasistencias</option>
                            </select>
                        </div>

                        <div class="filter-group">
                            <button disabled id="filtro-asis" type="submit">Cargar</button>
                        </div>
                    </div>
                </form>

                <div class="scroll-table">
                    <table>
                        <thead>
                            <tr>
                                <th>Alumno</th>
                                <th>Fecha</th>
                                <th>Puntualidad</th>
                            </tr>
                        </thead>
                        <tbody id="tabla-asistencias" class="tabla-asis">
                            <tr>
                                <td colspan="3">No se cargaron datos.</td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </section>
    <footer>
        <p>&copy; 2025 Escuela Secundaria San Martín. Todos los derechos reservados.</p>
    </footer>
    <script preload>

        actualizarBotonesActivos("cuenta");

        document.getElementById("cuenta").addEventListener("click", () => {
            document.getElementById("inicio").style.display = "flex";
            document.getElementById("asistencias").style.display = "none";
            actualizarBotonesActivos("cuenta");
        });

        document.getElementById("apartadoAsistencias").addEventListener("click", () => {
            document.getElementById("inicio").style.display = "none";
            document.getElementById("asistencias").style.display = "flex";
            actualizarBotonesActivos("apartadoAsistencias");
        });

        document.getElementById("anios").addEventListener("change", (event) => {
            event.target.options[0].disabled = true

            const anioSeleccionado = event.target.value
            fetch(`/filtros/cursos/${anioSeleccionado}`)
            .then(response => {
                if (response.ok) {
                    return response.json()
                } else {
                    throw new Error('Error al cargar los cursos')
                }
            }).then(data => {
                const cursosSelect = document.getElementById("cursos")
                const selectAlumno = document.getElementById("alumnos")
                const botonCargar = document.getElementById("filtro-asis")
                const cursos = data.body
                selectAlumno.innerHTML = '<option value="">-</option>'
                cursosSelect.innerHTML = '<option value="">-</option>'
                botonCargar.disabled = true
                botonCargar.style.backgroundColor = '#888d93'
                for( let i = 0; i < cursos.idAnio.length; i++) {
                    const option = document.createElement("option")
                    option.value = cursos.idAnio[i]
                    option.textContent = cursos.cursos[i]
                    cursosSelect.appendChild(option)
                }
            }).catch(error => {
                console.error(error)
            })
        })

        document.getElementById("cursos").addEventListener("change", (event) => {
            event.target.options[0].disabled = true

            const cursoId = event.target.value
            fetch(`/filtros/nombres/${cursoId}`)
            .then(response => {
                if (response.ok) {
                    return response.json()
                } else {
                    throw new Error('Error al cargar los cursos')
                }
            }).then(data => {
                const selectAlumno = document.getElementById("alumnos")
                const alumnos = data.body
                const botonCargar = document.getElementById("filtro-asis")
                if(!alumnos.idAlumnos[0]){
                    botonCargar.disabled = true
                    botonCargar.style.backgroundColor = '#888d93'
                    selectAlumno.innerHTML = '<option value="">No existen alumnos</option>'
                }
                else {
                    botonCargar.style.backgroundColor = '#007bff'
                    botonCargar.disabled = false
                    selectAlumno.innerHTML = '<option value="0">Todos</option>'
                    for (let i = 0; i < alumnos.idAlumnos.length; i++) {
                        const option = document.createElement("option")
                        option.value = alumnos.idAlumnos[i]
                        option.textContent = `${alumnos.nombres[i]} ${alumnos.apellidos[i]}`
                        selectAlumno.appendChild(option)
                    }
                }
            }).catch(error => {
                console.error(error)
            })

        })

        document.getElementById('filtro-asis').addEventListener('click', (event) => {
            event.preventDefault()
            const data = encodeURIComponent(JSON.stringify({
                idUser: document.getElementById('alumnos').options[document.getElementById('alumnos').selectedIndex].value,
                orden: document.getElementById('orden-asis').options[document.getElementById('orden-asis').selectedIndex].value,
                tipo: document.getElementById('tipo-asis').options[document.getElementById('tipo-asis').selectedIndex].value,
                idAnio: document.getElementById('anios').options[document.getElementById('anios').selectedIndex].value
            }))

            fetch(`/panel/asistencias/${data}`)
            .then(response => {
                if(response.ok){
                    return response.json()
                }else {
                    throw new error('Error al cargar las asistencias')
                }
            }).then(data => {
                const tablaAsistencias = document.getElementById('tabla-asistencias')
                const asistencias = data.body
                for( let i = 0; i < asistencias.fechas.length; i++){
                    const asistencia = document.createElement('tr')

                    const nombre = document.createElement('td')
                    nombre.textContent(asistencias.nombres[i])
                    asistencia.appendChild(nombre)

                    const fecha = document.createElement('td')
                    fecha.textContent(asistencias.fechas[i])
                    asistencia.appendChild(fecha)

                    const tipo = document.createElement('td')
                    tipo.textContent(asistencias.tipo[i])
                    asistencia.appendChild(tipo)

                    tablaAsistencias.appendChild(asistencia)
                }
            }).catch(error => {
                console.log(error)
            })

        })

        function actualizarBotonesActivos(idActivo) {
            document.querySelectorAll("#cuenta, #apartadoAsistencias").forEach(boton => {
                if (boton.id === idActivo) {
                    boton.classList.add("activo");
                } else {
                    boton.classList.remove("activo");
                }
            });
        }

        document.getElementById("cerrar-ses").addEventListener("click", () => {
            fetch('/logout', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json'
                }
            }).then(response => {
                if (typeof response.ok === 'boolean') {
                    window.location.href = '/'
                }
            })
        });

    </script>
</body>

</html>