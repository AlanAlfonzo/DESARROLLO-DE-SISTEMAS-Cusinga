<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Escuela San Martín</title>
    <link rel="stylesheet" href="../src/styles/style.css">
</head>
<body>
    <header>
        <div class="contenedor-header">
            <nav class="botones">
                <a href="/">INICIO</a>
                <a href="/especialidades">ESPECIALIDADES</a>
                <a href="/#contacto">CONTACTO</a>
                <% if(typeof ok === 'boolean' ){ %>
                    <a href="panel">PANEL</a>
                <% } %>
            </nav>
            <% if(typeof ok !== 'boolean' ){ %>
                <div class="logueo">
                    <a href="/register" id="reg">REGISTRARSE</a>
                    <a href="/login" id="log">LOGIN</a>
                </div>
            <% } %>
            <% if(typeof ok === 'boolean' ){%>
                <div class="tag-user">
                    <h2><%= nombres %></h2>
                </div>
            <% } %>
        </div>
    </header>

    <section id="inicio" class="seccion">
        <h2>Bienvenidos</h2>
        <p>La Escuela San Martín se dedica a brindar una educación integral, priorizando el desarrollo académico,
            personal y
            social de nuestros estudiantes.</p>
    </section>

    <section id="especialidades" class="seccion">
        <h2>ESPECIALIDADES</h2>
        <a id="compu" class="especialidad" href="especialidades.html#computacion">
            <h3>COMPUTACIÓN</h3>
        </a>
        <a id="meca" class="especialidad" href="especialidades.html#mecanica">
            <h3>MECÁNICA</h3>
        </a>
        <a id="auto" class="especialidad" href="especialidades.html#automotores">
            <h3>AUTOMOTORES</h3>
        </a>
    </section>

    <section id="contacto" class="seccion">
        <h2>Contacto</h2>
        <p><strong>Dirección:</strong> Teodoro Garcia 777, Buenos Aires</p>
        <p><strong>Email:</strong> info@sanmartin.edu.ar</p>
        <p><strong>Teléfono:</strong> (011) 4567-8901</p>
    </section>

    <footer>
        <p>&copy; 2025 Escuela Secundaria San Martín. Todos los derechos reservados.</p>
    </footer>
</body>

</html>