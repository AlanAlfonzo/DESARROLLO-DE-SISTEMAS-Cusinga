<!DOCTYPE html>
<html lang="es">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
    <link rel="stylesheet" href="../src/styles/styleLog.css">
</head>

<body>
    <header>
        <div class="contenedor-header">
            <nav class="botones">
                <a href="/">INICIO</a>
                <a href="/especialidades">ESPECIALIDADES</a>
                <a href="/#contacto">CONTACTO</a>
            </nav>
            <div class="logueo">
                <a href="/register" id="reg">REGISTRARSE</a>
                <a href="/login" id="log">LOGIN</a>
            </div>
        </div>
    </header>
    <main>
        <div class="main-login">
            <form class="form-login" method="post" action="/login">
                <h2>Inicie Sesion</h2>
                <label for="email">Correo Electronico:</label>
                <input type="email" name="email" id="emailLogin" placeholder="MailEjemplo@gmail.com" required>

                <label for="password">Contraseña:</label>
                <input type="password" name="password" id="password" placeholder="Ingrese su contraseña" required>

                <button id="btn-login" type="submit">Login</button>
            </form>
        </div>
    </main>
    <footer>
        <p>&copy; 2025 Escuela Secundaria San Martín. Todos los derechos reservados.</p>
    </footer>
    <script>

    </script>
</body>

</html>